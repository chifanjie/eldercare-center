<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="edu.ysu.backend.mapper.OrdersMapper">

    <resultMap id="OrderWithUser" type="edu.ysu.backend.entity.Orders">
        <id property="orderid" column="orderid"/>
        <result property="orderDate" column="orderDate"/>
        <result property="userid" column="userid"/>
        <result property="hpid" column="hpid"/>
        <result property="smid" column="smid"/>
        <result property="state" column="state"/>
        <!--添加一方对象-->
        <association property="users" column="userid"
                     javaType="edu.ysu.backend.entity.Users" select="edu.ysu.backend.mapper.UsersMapper.find">
            <id property="userid" column="userid"/>
            <result property="realname" column="realname"/>
            <result property="sex" column="sex"/>
        </association>
        <association property="hospital" javaType="edu.ysu.backend.entity.Hospital" column="hpid" select="edu.ysu.backend.mapper.HospitalMapper.find">
<!--            <id property="hpid" column="hpid"/>-->
<!--            <result property="name" column="name"/>-->
        </association>
        <association property="setmeal" javaType="edu.ysu.backend.entity.Setmeal" column="smid" select="edu.ysu.backend.mapper.SetmealMapper.find">
<!--            <id property="smid" column="smid"/>-->
<!--            <result property="name" column="name"/>-->
        </association>

    </resultMap>

    <select id="findBySql" resultMap="OrderWithUser">
        select  e.orderid, e.orderDate, e.userid, e.hpid, e.smid, e.state,
                d.userid, d.realname, d.sex
        from orders  e  inner  join users d on e.userid = d.userid
        <where>
            <if test="userid!=null and userid!=''">
                and e.userid like '%${userid}%'
            </if>
            <if test="realname!=null and realname!=''">
                and d.realname like '%${realname}%'
            </if>
            <if test="orderDate!=null and orderDate!=''">
                and e.orderDate=#{orderDate}
            </if>
            <if test="state!=null and state!=0 and state!=''">
                and e.state=#{state}
            </if>
            <if test="smid!=null and smid!=0 and smid!=''">
                and e.smid=#{smid}
            </if>
            <if test="sex!=null and sex!=0 and sex!=''">
                and d.sex=#{sex}
            </if>
             and e.state!=0
        </where>
            limit #{start},#{pageSize}
    </select>
    <select id="findBySql2" resultMap="OrderWithUser">
        select  e.orderid, e.orderDate, e.userid, e.hpid, e.smid, e.state,
        d.userid, d.realname, d.sex
        from orders  e
        inner  join users d on e.userid = d.userid
        <where>
            <if test="userid!=null and userid!=''">
                and e.userid like '%${userid}%'
            </if>
            <if test="realname!=null and realname!=''">
                and d.realname like '%${realname}%'
            </if>
            <if test="orderDate!=null and orderDate!=''">
                and e.orderDate=#{orderDate}
            </if>
            <if test="state!=null and state!=0 and state!=''">
                and e.state=#{state}
            </if>
            <if test="smid!=null and smid!=0 and smid!=''">
                and e.smid=#{smid}
            </if>
            <if test="sex!=null and sex!=0 and sex!=''">
                and d.sex=#{sex}
            </if>
            and e.state!=0
        </where>
    </select>
</mapper>
